#!/usr/bin/env bash
# Stands in for the codex CLI in tests/check.sh: records its arguments and
# replies without calling a model.
#
#   STUB_RECORD  folder where each call's arguments are saved, NUL-separated
#   STUB_REPLY   the reply written to the -o file; empty means none. With
#                --output-schema it defaults to a passing review in JSON
#   STUB_RESUME_REPLY  the reply after a resume
#   STUB_SLEEP   seconds to wait before replying, in a child process, the way
#                the Superset wrapper runs the real binary
#   STUB_CODEX_VERSION  what --version reports
set -euo pipefail

if [ "${1:-}" = --version ]; then echo "codex-cli ${STUB_CODEX_VERSION:-0.160.1}"; exit 0; fi

n=1
while [ -e "$STUB_RECORD/codex.$n" ]; do n=$((n + 1)); done
printf '%s\0' "$@" > "$STUB_RECORD/codex.$n"

out="" resume=0 json=0 schema=0 previous=""
for arg in "$@"; do
  if [ "$previous" = "-o" ]; then out="$arg"; fi
  case "$arg" in
    resume) resume=1 ;;
    --json) json=1 ;;
    --output-schema) schema=1 ;;
  esac
  previous="$arg"
done

if [ "$json" = 1 ]; then echo '{"type":"thread.started","thread_id":"stub-thread"}'; fi
if [ "$resume" = 0 ] && [ -n "${STUB_SLEEP:-}" ]; then
  # A turn that finished before the one the deadline cuts short.
  echo '{"type":"turn.completed","usage":{"input_tokens":100,"cached_input_tokens":40,"output_tokens":7}}'
  sleep "$STUB_SLEEP" &
  echo $! > "$STUB_RECORD/codex.child"
  wait
fi

default="NO MUST-FIX FINDINGS"
if [ "$schema" = 1 ]; then default='{"verdict":"PASS","findings":[],"below_threshold":[],"declined":[]}'; fi
reply="${STUB_REPLY-$default}"
if [ "$resume" = 1 ]; then reply="${STUB_RESUME_REPLY:-FINDINGS AFTER RESUME}"; fi
if [ -n "$out" ] && [ -n "$reply" ]; then printf '%s\n' "$reply" > "$out"; fi
if [ "$json" = 1 ]; then
  echo '{"type":"turn.completed","usage":{"input_tokens":100,"cached_input_tokens":40,"output_tokens":7}}'
fi
