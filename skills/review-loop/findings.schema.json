        "additionalProperties": false,
        "required": ["file", "line", "summary", "failure_scenario", "confidence"],
        "properties": {
          "file": {"type": "string"},
          "line": {"type": "integer"},
          "summary": {"type": "string"},
          "failure_scenario": {"type": "string"},
          "confidence": {"type": "string", "enum": ["confirmed-by-running", "confirmed-by-reading", "plausible"]}
